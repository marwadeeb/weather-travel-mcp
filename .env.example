# Which OpenAI-compatible LLM the agent uses: gemini | groq | openrouter | openai
LLM_PROVIDER=gemini

# Free key for Gemini: https://aistudio.google.com/apikey
# Free key for Groq:   https://console.groq.com/keys
LLM_API_KEY=paste-your-key-here

# Optional overrides (defaults are set per provider in agent.py)
# LLM_MODEL=gemini-3.5-flash   (if it is overloaded, try gemini-3.5-flash-lite or gemini-3.8-flash)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Optional: where saved trips are stored (default: data/trips.json)
# TRIPS_FILE=data/trips.json
